{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioExtract",
  "version": "../package.json",
  "identifier": "com.audioextract.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioExtract",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "copyright": "© 2026 Paúl Pérez · GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Separa canciones en pistas por instrumento, en tu propio equipo",
    "longDescription": "AudioExtract separa una canción en voces, batería, bajo, guitarra, piano, viento y otros con modelos abiertos (Demucs, BS-RoFormer, UVR) que se ejecutan en local. Incluye un mezclador con transposición por semitonos, exportación a WAV o MP3 y una biblioteca de extracciones.",
    "createUpdaterArtifacts": false,
    "resources": {
      "../LICENSE": "LICENSE",
      "../python/separate.py": "python/separate.py",
      "../python/transcribe.py": "python/transcribe.py",
      "../python/catalog.py": "python/catalog.py",
      "../python/requirements.txt": "python/requirements.txt",
      "../python/requirements-transcription.txt": "python/requirements-transcription.txt",
      "../python/wheels/*.whl": "python/wheels/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0RTU4QUY2NDYzOTFBQzIKUldUQ0dqbEc5b3JsOUcwUVc4UUpvL0Jsa3F0Sm52OW9oL2FKOFZFaDhjWC9FNUhFTW1FRmlMS0YK",
      "endpoints": [
        "https://github.com/paulalvarado/AudioExtract/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
