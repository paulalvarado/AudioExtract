{
  "name": "audioextract",
  "private": true,
  "version": "1.1.0",
  "description": "Separación local de canciones en pistas por instrumento (Tauri + React + Demucs/BS-RoFormer)",
  "license": "GPL-3.0-or-later",
  "author": "Paúl Pérez",
  "repository": "github:paulalvarado/AudioExtract",
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor-wheels.mjs && node scripts/vendor-uv.mjs",
    "dev": "vite",
    "dev:web": "vite --mode demo",
    "prebuild": "node scripts/vendor-wheels.mjs && node scripts/vendor-uv.mjs",
    "build": "tsc -b && vite build",
    "vendor:wheels": "node scripts/vendor-wheels.mjs",
    "vendor:uv": "node scripts/vendor-uv.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "docker:engine": "docker build -f docker/engine.Dockerfile -t audioextract-engine python",
    "docker:check": "docker run --rm --gpus all --network none audioextract-engine --check",
    "docker:app": "node scripts/vendor-wheels.mjs && docker build -f docker/app.Dockerfile --target export --output type=local,dest=release .",
    "docker:test": "node scripts/vendor-wheels.mjs && docker build -f docker/app.Dockerfile --target tests --output type=local,dest=release/tests . && release\\tests\\audioextract-tests.exe",
    "engine:lock": "docker run --rm -v ./:/src -w /src python:3.12-slim sh scripts/lock-engine.sh",
    "nsis:template": "node scripts/nsis-template.mjs",
    "updater:setup": "node scripts/setup-updater.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.6.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signalsmith-stretch": "1.3.2",
    "wasm-media-encoders": "~0.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.12.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
